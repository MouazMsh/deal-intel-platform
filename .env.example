# Copy to .env for local development. Never commit the real .env file.
# Production values are set as GitHub Environment secrets (see SECURITY.md),
# never written to any file in this repository.

# --- Runtime ---
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Riyadh

# --- Database ---
# Dev/test default is local SQLite. Production MUST be a PostgreSQL URL
# (Neon) — app/core/config.py refuses to start otherwise.
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Production public channel ONLY. Leave empty in development.
TELEGRAM_CHANNEL_ID=
# Private channel for manual verification outside production.
TELEGRAM_TEST_CHANNEL_ID=
# Safe default: no real Telegram calls unless explicitly disabled.
DRY_RUN=true

# --- Providers ---
AMAZON_PROVIDER_ENABLED=false
AMAZON_API_KEY=
AMAZON_API_SECRET=

# NOON_PROVIDER_ENABLED must stay false — app/core/config.py will refuse to
# start if this is set to true. No compliant Noon product/price data source
# exists yet. See CONTRIBUTING.md.
NOON_PROVIDER_ENABLED=false
NOON_API_KEY=
NOON_API_SECRET=

# --- Deal engine (used starting Phase 2) ---
PRICE_HISTORY_DAYS=90
MIN_DEAL_SCORE=70
MIN_CONFIDENCE_FOR_GRADE=50
FLASH_DEAL_THRESHOLD=20
REPUBLISH_COOLDOWN_HOURS=24

# --- Scheduler (used starting Phase 4) ---
SCAN_FREQUENCY_MINUTES=30
